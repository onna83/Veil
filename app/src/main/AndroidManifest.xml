<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- INTERNET is used ONLY for model downloads the user starts by tapping
         "Download" in the model manager (HTTPS, SHA-256 verified). No analytics,
         no background traffic; screen content never leaves the device. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- declared by the ONNX Runtime AAR; inference does not need it -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <!-- added by androidx.core for registerReceiver(NOT_EXPORTED) on API < 33; minSdk is 34 -->
    <permission android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" tools:node="remove" />
    <uses-permission android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Veil"
        tools:targetApi="35">


        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ModelsActivity" android:exported="false" android:parentActivityName=".MainActivity" />
        <activity android:name=".PerformanceActivity" android:exported="false" android:parentActivityName=".MainActivity" />
        <activity android:name=".DebugActivity" android:exported="false" android:parentActivityName=".MainActivity" />
        <activity android:name=".AboutActivity" android:exported="false" android:parentActivityName=".MainActivity" />
        <activity android:name=".A11yActivity" android:exported="false" android:parentActivityName=".PerformanceActivity" />

        <service
            android:name=".CaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- v1.8 optional Accessibility mode (off unless the user enables it in
             Performance > Accessibility mode AND in Android's accessibility settings).
             Used only for: one touch-through overlay window for all censors, scroll /
             window-change event timing, and in-memory screenshots of the foreground
             app window to check what is under Veil's own censors. Reads no text. -->
        <service
            android:name=".VeilAccessibilityService"
            android:exported="false"
            android:label="@string/a11y_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>
    </application>
</manifest>
